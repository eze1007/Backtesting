{
  "name": "backtesting",
  "version": "0.1.0",
  "private": true,
  "description": "App web di backtesting manuale con replay del grafico e simulazione di sfide prop firm",
  "scripts": {
    "dev": "next dev",
    "dev:demo": "DATA_SOURCE=demo next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sources": "RUN_SOURCE_TESTS=1 vitest run tests/sources.test.ts",
    "e2e": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "lightweight-charts": "4.2.3",
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dukascopy-node": "1.51.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
